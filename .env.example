# Copy to .env and fill in your existing Aiven settings. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
MYSQL_HOST=your-aiven-mysql-host
MYSQL_PORT=your-aiven-mysql-port
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=your-existing-database
MYSQL_SSL_CA=certs/ca.pem

# Google account sign-in (use your existing OAuth web client credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized local redirect URI: http://127.0.0.1:5000/auth/google/callback

# Optional IP status checks
APIFREAKS_API_KEY=
